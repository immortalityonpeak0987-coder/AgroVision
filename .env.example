# AgroVision — Confirmed API Endpoints & Supporting Portals Configuration
# Tested & Verified for NASA Space Apps Challenge 2026

# 1. NASA POWER (HTTP 200 Live — Public Open API, No Key Required)
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/daily/point"

# 2–5. IMD APIs (current_wx, districtrainfall, staterainfall, aws_data)
# Returns HTTP 401 {"error":"API key missing"} until IMD_API_KEY + IP Whitelist are configured
IMD_API_BASE_URL="https://api.imd.gov.in/api/v1"
IMD_CURRENT_WX_URL="https://api.imd.gov.in/api/v1/current_wx"
IMD_DISTRICT_RAINFALL_URL="https://api.imd.gov.in/api/v1/districtrainfall"
IMD_STATE_RAINFALL_URL="https://api.imd.gov.in/api/v1/staterainfall"
IMD_AWS_DATA_URL="https://api.imd.gov.in/api/v1/aws_data"
IMD_API_KEY=""
IMD_BEARER_TOKEN=""

# 6. NASA AppEEARS (/api/product returns HTTP 200 Live; /api/task requires Earthdata Token)
APPEEARS_BASE_URL="https://appeears.earthdatacloud.nasa.gov/api"
EARTHDATA_USERNAME=""
EARTHDATA_PASSWORD=""
EARTHDATA_TOKEN=""

# 7. NASA CMR Collections & Granules (HTTP 200 Live — Public Open API, No Key Required)
CMR_COLLECTIONS_URL="https://cmr.earthdata.nasa.gov/search/collections.json"
CMR_BASE_URL="https://cmr.earthdata.nasa.gov/search"

# 8. Google Earth Engine REST API ($discovery/rest?version=v1 returns HTTP 200 Live)
# Raster compute endpoints require GCP Project ID & Service Account JSON
EARTH_ENGINE_DISCOVERY_URL="https://earthengine.googleapis.com/$discovery/rest?version=v1"
EARTH_ENGINE_BASE_URL="https://earthengine.googleapis.com/v1"
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Supporting Reference Portals (Non-Direct APIs — Ground/Soil/Advisory Reference)
BHOOMI_PORTAL_URL="https://bhoomigeoportal-nbsslup.in/"
MATIR_KATHA_PORTAL_URL="https://matirkatha.net/"
SOIL_HEALTH_CARD_PORTAL_URL="https://soilhealth.dac.gov.in/"

# Runtime & Database Configuration
ALLOW_MEMORY_DB="true"
MONGODB_URI=""
APP_URL="http://localhost:3000"
